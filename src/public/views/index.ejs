     </i>
     Installation
    </h2>
    <div class="mb-4">
     <h3 class="text-lg font-semibold mb-2">
      Clone Repository
     </h3>
     <pre class="bg-gray-100 p-4 rounded-lg"><code>git clone https://github.com/remancodeking/backcraft.git</code></pre>
    </div>
    <div class="mb-4">
     <h3 class="text-lg font-semibold mb-2">
      Install with npm
     </h3>
     <pre class="bg-gray-100 p-4 rounded-lg"><code>cd node-folder
npm install</code></pre>
    </div>
    <div class="mb-4">
     <h3 class="text-lg font-semibold mb-2">
      Install with yarn
     </h3>
     <pre class="bg-gray-100 p-4 rounded-lg"><code>cd node-folder
yarn install</code></pre>
    </div>
    <div class="mb-4">
     <h3 class="text-lg font-semibold mb-2">
      Install with pnpm
     </h3>
     <pre class="bg-gray-100 p-4 rounded-lg"><code>cd node-folder
pnpm install</code></pre>
    </div>
   </section>
